{
  "name": "dynamic-island",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "bridge": "node scripts/system-media-bridge.ts",
    "build:widget": "vite build --mode widget --config vite.widget.config.ts",
    "build:electron": "node scripts/build-electron.mjs",
    "make:icon": "electron scripts/make-icon.cjs",
    "dev:widget": "vite build --mode widget --config vite.widget.config.ts && electron .",
    "dist:win": "pnpm build:widget && pnpm build:electron && electron-builder --win"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
