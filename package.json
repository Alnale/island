{
  "name": "dynamic-island",
  "private": true,
  "version": "3.5.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b tsconfig/tsconfig.json && vite build",
    "lint": "oxlint",
    "typecheck": "tsc -b tsconfig/tsconfig.json tsconfig/tsconfig.app.json tsconfig/tsconfig.electron.json tsconfig/tsconfig.node.json",
    "test": "pnpm test:unit && pnpm test:core",
    "test:unit": "pnpm test:settings && pnpm test:background && pnpm test:markdown && pnpm test:repeat",
    "test:repeat": "node tests/test-repeat-position.mjs",
    "test:markdown": "node tests/test-markdown.mjs",
    "test:settings": "node tests/test-settings-store.cjs",
    "test:background": "node tests/test-background-store.cjs",
    "test:core": "node tests/test-agent-core.mjs",
    "test:runtime": "node scripts/test-electron-node.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm test:runtime",
    "audit:release": "node scripts/audit-release.mjs --strict",
    "preview": "vite preview",
    "bridge": "node scripts/system-media-bridge.ts",
    "build:widget": "vite build --mode widget --config vite.widget.config.ts",
    "build:electron": "node scripts/build-electron.mjs",
    "make:icon": "node scripts/launch-dev-electron.mjs scripts/make-icon.cjs",
    "dev:widget": "pnpm build:electron && vite build --mode widget --config vite.widget.config.ts && node scripts/launch-dev-electron.mjs .",
    "watch:electron": "node scripts/watch-electron.mjs"
  },
  "dependencies": {
    "mermaid": "^11.16.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "electron": "^43.2.0",
    "esbuild": "^0.28.1",
    "oxlint": "^1.75.0",
    "rcedit": "^5.0.2",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
