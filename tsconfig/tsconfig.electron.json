{
  "compilerOptions": {
    "tsBuildInfoFile": "../node_modules/.tmp/tsconfig.electron.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "types": ["node"],
    "skipLibCheck": true,

    /* esbuild 打包语义(bundler 解析允许无扩展名相对导入,与
       build-electron.mjs 一致;文件不直接以 node 运行) */
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  /* tests/ 直接导入 electron/agent 源码,与本 config 同语义检查;
     不纳入时测试文件落入 IDE 推断项目(默认严格),报一堆假错
     (2026-08-14 修复:mock config 缺 activeProvider/providers、隐式 any) */
  "include": ["../electron/**/*.ts", "../scripts/system-media-bridge.ts", "../tests/**/*.ts"]
}
